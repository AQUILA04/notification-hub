# --- PostgreSQL ---
POSTGRES_DB=notification_hub
POSTGRES_USER=nhub
POSTGRES_PASSWORD=changeme

# --- Redis ---
REDIS_PASSWORD=

# --- Artemis ---
ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=artemis

# --- Keycloak ---
KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=admin
KEYCLOAK_REALM=notification-hub

# --- App ---
SPRING_PROFILES_ACTIVE=docker
APP_PORT=8088
OIDC_ISSUER_URI=http://localhost:8081/realms/notification-hub

# --- SMS strategy: AfrikSMS (prod) / logging (local sans clés) ---
# Twilio n'est PAS utilisé pour le SMS — réservé WhatsApp (P2).
SMS_PROVIDER=afriksms
SMS_DEFAULT_FROM=MyBrand
AFRIKSMS_CLIENT_ID=
AFRIKSMS_API_KEY=
AFRIKSMS_BASE_URL=https://api.afriksms.com/api/web/web_v1/outbounds

# Twilio — WhatsApp only (P2). SMS reste AfrikSMS.
# Activer le canal : WHATSAPP_ENABLED=true (+ credentials)
WHATSAPP_ENABLED=false
WHATSAPP_PROVIDER=twilio
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_URL=

# --- P3 hardening ---
QUOTA_ENABLED=true
QUOTA_DEFAULT_PER_MINUTE=120
QUOTA_EMAIL_PER_MINUTE=200
QUOTA_SMS_PER_MINUTE=60
QUOTA_WHATSAPP_PER_MINUTE=30
CIRCUIT_BREAKER_ENABLED=true
CIRCUIT_BREAKER_FAILURE_THRESHOLD=5
CIRCUIT_BREAKER_OPEN_SECONDS=60
COST_EMAIL=0.0001
COST_SMS=0.04
COST_WHATSAPP=0.05

# Optional generic HTTP SMS (debug)
SMS_HTTP_URL=
SMS_HTTP_AUTH=
