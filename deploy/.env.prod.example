# =============================================================================
# Notification Hub — PROD .env template
# Copy to /opt/notification-hub/prod/.env (never commit real secrets).
# Generated automatically by setup-server.sh / init.sh on first deploy.
#
# Shared tools (redis, artemis, keycloak) come from optimize-common-infra.
# REDIS_PASSWORD / ARTEMIS_* must match /opt/optimizesolux/common-infra/.env
# =============================================================================

DB_USER=nhub
DB_PASSWORD=CHANGE_ME_prod_db_password
DB_NAME=notification_hub

APP_HOSTNAME=notification.optimizesolux.com
API_HOSTNAME=notification-api.optimizesolux.com
CORS_ORIGINS=https://notification.optimizesolux.com
OIDC_ISSUER_URI=https://auth.optimizesolux.com/realms/notification-hub

ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=CHANGE_ME_artemis_password
REDIS_PASSWORD=CHANGE_ME_redis
REDIS_DATABASE=1

MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASS=CHANGE_ME_resend_api_key
MAIL_FROM="Notification Hub <noreply@optimizesolux.com>"

# SMS test intercept (environment ≠ prod) — email Resend, pas de SMS réel
SMS_TEST_MAIL_FROM=noreply@optimizesolux.com
SMS_TEST_MAIL_TO=sms@optimizesolux.com

SMS_PROVIDER=brevo
BREVO_API_KEY=
BREVO_BASE_URL=https://api.brevo.com/v3
BREVO_SMS_WEBHOOK_URL=https://notification-api.optimizesolux.com/v1/webhooks/brevo
SMS_DEFAULT_FROM=OptimizeSLX
AFRIKSMS_CLIENT_ID=
AFRIKSMS_API_KEY=
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_STATUS_CALLBACK_URL=https://notification-api.optimizesolux.com/v1/webhooks/twilio
TWILIO_WHATSAPP_FROM=
TWILIO_WHATSAPP_OTP_CONTENT_SID=

# OTP — Twilio Verify (secrets GitHub → CD → /opt/notification-hub/prod/.env)
OTP_ENABLED=true
OTP_PROVIDER=twilio-verify
OTP_DEFAULT_CHANNEL=SMS
TWILIO_VERIFY_SERVICE_SID=

# Populated automatically by deploy.sh — do not edit manually
FRONTEND_IMAGE=
BACKEND_IMAGE=
