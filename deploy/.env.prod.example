# =============================================================================
# Notification Hub — PROD .env template
# Copy to /opt/notification-hub/prod/.env (never commit real secrets).
# Generated automatically by setup-server.sh / init.sh on first deploy.
# =============================================================================

DB_USER=nhub
DB_PASSWORD=CHANGE_ME_prod_db_password
DB_NAME=notification_hub

KEYCLOAK_ADMIN=admin
KEYCLOAK_ADMIN_PASSWORD=CHANGE_ME_keycloak_admin_password
KEYCLOAK_HOSTNAME=notification-auth.optimizesolux.com
KEYCLOAK_IMAGE=quay.io/keycloak/keycloak:26.2.5
KEYCLOAK_REALM_PATH=/opt/notification-hub/deploy/keycloak/realm-notification-hub.json

APP_HOSTNAME=notification.optimizesolux.com
API_HOSTNAME=notification-api.optimizesolux.com
CORS_ORIGINS=https://notification.optimizesolux.com
OIDC_ISSUER_URI=https://notification-auth.optimizesolux.com/realms/notification-hub

ARTEMIS_USER=artemis
ARTEMIS_PASSWORD=CHANGE_ME_artemis_password
REDIS_PASSWORD=

MAIL_HOST=smtp.resend.com
MAIL_PORT=465
MAIL_USER=resend
MAIL_PASS=CHANGE_ME_resend_api_key
MAIL_FROM="Notification Hub <noreply@optimizesolux.com>"

SMS_PROVIDER=afriksms
AFRIKSMS_CLIENT_ID=
AFRIKSMS_API_KEY=
SMS_DEFAULT_FROM=
WHATSAPP_ENABLED=false
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Populated automatically by deploy.sh — do not edit manually
FRONTEND_IMAGE=
BACKEND_IMAGE=
